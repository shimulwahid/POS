<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="POS.Site1" %>
<!DOCTYPE html>
<html><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title><%: Page.Title %> - Shop POS</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<link href="res/Bootstrap/bootstrap.min.css" rel="stylesheet" />
<link href="res/Datatables/jquery.dataTables.min.css" rel="stylesheet" />

<script src="res/Datatables/jquery-3.7.1.js"></script>
<script src="res/Datatables/jquery.dataTables.min.js"></script>
<style>
/* ═══════════════════════════════════════════════════════════
   DESIGN SYSTEM — Premium POS Theme
   ═══════════════════════════════════════════════════════════ */
:root {
    --sidebar-bg: #0f172a;
    --sidebar-bg2: #1e293b;
    --sidebar-border: rgba(148,163,184,.08);
    --accent: #6366f1;
    --accent-light: #818cf8;
    --accent-glow: rgba(99,102,241,.25);
    --accent-surface: #eef2ff;
    --accent-text: #3730a3;
    --canvas: #f1f5f9;
    --card: #ffffff;
    --text: #0f172a;
    --text-secondary: #475569;
    --text-muted: #94a3b8;
    --border: #e2e8f0;
    --border-light: #f1f5f9;
    --success: #10b981;
    --success-surface: #ecfdf5;
    --warning: #f59e0b;
    --warning-surface: #fffbeb;
    --danger: #ef4444;
    --danger-surface: #fef2f2;
    --topbar-height: 64px;
    --sidebar-width: 250px;
    --sidebar-collapsed: 76px;
    --radius: 12px;
    --radius-lg: 16px;
    --shadow-sm: 0 1px 3px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04);
    --shadow: 0 4px 16px rgba(15,23,42,.08);
    --shadow-lg: 0 10px 40px rgba(15,23,42,.12);
    --transition: .2s cubic-bezier(.4,0,.2,1);
}

* { box-sizing: border-box; margin: 0; }
body { background: var(--canvas); color: var(--text); font-family: 'Inter', system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }

/* ── Scrollbar ── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
.sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); }

/* ══════════════════ SIDEBAR ══════════════════ */
.sidebar {
    width: var(--sidebar-width);
    background: linear-gradient(175deg, #0f172a 0%, #1a1f3a 50%, #0f172a 100%);
    position: fixed; inset: 0 auto 0 0;
    padding: 0; z-index: 1030;
    transition: width var(--transition);
    overflow-y: auto; overflow-x: hidden;
    display: flex; flex-direction: column;
    border-right: 1px solid rgba(255,255,255,.06);
}
.sidebar::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse at 30% 0%, rgba(99,102,241,.08) 0%, transparent 70%);
}

/* Brand */
.brand {
    padding: 22px 20px 18px;
    display: flex; align-items: center; gap: 12px;
    border-bottom: 1px solid rgba(255,255,255,.06);
    position: relative; flex-shrink: 0;
}
.brand-icon {
    width: 38px; height: 38px; border-radius: 10px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 12px rgba(99,102,241,.35);
    flex-shrink: 0;
}
.brand-icon svg { width: 20px; height: 20px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.brand-text { color: #f8fafc; font-size: 1.2rem; font-weight: 800; letter-spacing: -.02em; }
.brand-dot { color: #818cf8; }

/* Nav Links */
.sidebar-nav { padding: 12px 10px; flex: 1; }
.sidebar .nav-link {
    color: #94a3b8 !important; border-radius: 10px;
    padding: 10px 14px; margin: 2px 0;
    font-size: .875rem; font-weight: 600;
    display: flex; align-items: center; gap: 12px;
    transition: all var(--transition);
    position: relative; text-decoration: none;
}
.sidebar .nav-link:hover {
    color: #e2e8f0 !important;
    background: rgba(255,255,255,.07);
    transform: translateX(3px);
}
.sidebar .nav-link.active {
    color: #fff !important;
    background: linear-gradient(135deg, rgba(99,102,241,.2), rgba(139,92,246,.12));
    box-shadow: inset 0 0 0 1px rgba(99,102,241,.25);
}
.sidebar .nav-link.active .nav-icon { background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; box-shadow: 0 2px 8px rgba(99,102,241,.4); }
.nav-icon {
    width: 34px; height: 34px; border-radius: 9px;
    background: rgba(148,163,184,.1);
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: all var(--transition);
}
.nav-icon svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.menu-text { white-space: nowrap; overflow: hidden; transition: opacity .15s; }
.sidebar-section { padding: 16px 16px 6px; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #475569; }
.sidebar-divider { border: 0; border-top: 1px solid rgba(255,255,255,.06); margin: 10px 14px; }

/* ══════════════════ COLLAPSED SIDEBAR ══════════════════ */
.sidebar.collapsed { width: var(--sidebar-collapsed); }
.sidebar.collapsed .menu-text,
.sidebar.collapsed .brand-text,
.sidebar.collapsed .sidebar-section { opacity: 0; width: 0; overflow: hidden; }
.sidebar.collapsed .brand { justify-content: center; padding: 22px 10px 18px; }
.sidebar.collapsed .nav-link { justify-content: center; padding: 10px; }
.sidebar.collapsed + .main-content { margin-left: var(--sidebar-collapsed); }

/* ══════════════════ MAIN CONTENT ══════════════════ */
.main-content {
    margin-left: var(--sidebar-width);
    min-height: 100vh;
    transition: margin-left var(--transition);
    animation: fadeSlideIn .4s ease-out;
}
@keyframes fadeSlideIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

/* ══════════════════ TOPBAR ══════════════════ */
.topbar {
    height: var(--topbar-height);
    background: rgba(255,255,255,.85);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 28px;
    position: sticky; top: 0; z-index: 1020;
}
.topbar-left { display: flex; align-items: center; gap: 14px; }
.topbar-title { font-weight: 700; font-size: 1.05rem; color: var(--text); }
.topbar-right { display: flex; align-items: center; gap: 16px; }
.topbar-clock { font-size: .82rem; color: var(--text-muted); font-weight: 500; font-variant-numeric: tabular-nums; }
.sidebar-toggle {
    border: 0; background: var(--accent-surface); color: var(--accent);
    border-radius: 9px; width: 38px; height: 38px;
    font-weight: 800; cursor: pointer;
    transition: all var(--transition);
    display: flex; align-items: center; justify-content: center;
}
.sidebar-toggle:hover { background: var(--accent); color: #fff; box-shadow: 0 4px 12px var(--accent-glow); }
.sidebar-toggle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.user-chip {
    background: var(--accent-surface); color: var(--accent-text);
    border-radius: 999px; padding: 7px 16px 7px 12px;
    font-size: .82rem; font-weight: 700;
    display: inline-flex; align-items: center; gap: 8px;
}
.user-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); flex-shrink: 0; }

/* ══════════════════ GLOBAL COMPONENT STYLES ══════════════════ */
.card { border: 0 !important; border-radius: var(--radius-lg) !important; box-shadow: var(--shadow-sm); background: var(--card); transition: box-shadow var(--transition), transform var(--transition); }
.card:hover { box-shadow: var(--shadow); }
.btn { border-radius: var(--radius); font-weight: 600; font-size: .875rem; transition: all var(--transition); }
.btn:hover { transform: translateY(-1px); }
.btn-primary { background: linear-gradient(135deg, #6366f1, #4f46e5); border: 0; box-shadow: 0 2px 8px var(--accent-glow); }
.btn-primary:hover { background: linear-gradient(135deg, #818cf8, #6366f1); box-shadow: 0 4px 16px var(--accent-glow); }
.btn-success { background: linear-gradient(135deg, #10b981, #059669); border: 0; }
.btn-success:hover { background: linear-gradient(135deg, #34d399, #10b981); }
.btn-danger { background: linear-gradient(135deg, #ef4444, #dc2626); border: 0; }
.btn-outline-primary { border-color: var(--accent); color: var(--accent); }
.btn-outline-primary:hover { background: var(--accent); color: #fff; }
.form-control, .form-select { border-radius: var(--radius); border-color: var(--border); font-size: .9rem; transition: border-color var(--transition), box-shadow var(--transition); }
.form-control:focus, .form-select:focus { border-color: var(--accent-light); box-shadow: 0 0 0 3px var(--accent-glow); }
.shop-name {
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--accent);
    letter-spacing: .02em;
}
.center-shop-name {

    position:absolute;

    left:50%;

    transform:translateX(-50%);

    font-size:1.7rem;

    font-weight:900;

    color:var(--accent);

    letter-spacing:.03em;

    white-space:nowrap;

}


.topbar {

    position:sticky;

}
/* Tables */
.table { background: #fff; margin-bottom: 0; }
.table thead th {
    background: #f8fafc; color: #475569; border-color: var(--border);
    font-size: .78rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; padding: 12px 16px;
}
.table tbody td { padding: 12px 16px; vertical-align: middle; border-color: var(--border-light); color: var(--text); }
.table-hover tbody tr:hover { background: #f8fafc; }
.dataTables_wrapper { padding: 2px; }
.dataTables_wrapper .dataTables_filter input { border-radius: var(--radius); border: 1px solid var(--border); padding: 6px 12px; }
.dataTables_wrapper .dataTables_length select { border-radius: var(--radius); border: 1px solid var(--border); }

/* Alerts */
.alert { border-radius: var(--radius); font-weight: 500; border: 0; }
.alert-success { background: var(--success-surface); color: #065f46; }
.alert-danger { background: var(--danger-surface); color: #991b1b; }
.alert-warning { background: var(--warning-surface); color: #92400e; }
.alert-info { background: #eff6ff; color: #1e40af; }

/* Modals */
.modal-content { border: 0; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
.modal-header { border-bottom: 1px solid var(--border-light); padding: 20px 24px; }
.modal-body { padding: 24px; }
.modal-footer { border-top: 1px solid var(--border-light); padding: 16px 24px; }

/* Badges / Pills */
.badge { font-weight: 600; border-radius: 6px; padding: 5px 10px; font-size: .75rem; }
.pill { display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px; border-radius: 999px; font-size: .78rem; font-weight: 600; }
.pill-success { background: var(--success-surface); color: #065f46; }
.pill-warning { background: var(--warning-surface); color: #92400e; }
.pill-danger { background: var(--danger-surface); color: #991b1b; }
.pill-info { background: #eff6ff; color: #1e40af; }

/* ══════════════════ ~/resPONSIVE ══════════════════ */
@media (max-width: 768px) {
    .sidebar { transform: translateX(-100%); }
    .sidebar.mobile-open { transform: translateX(0); box-shadow: 8px 0 30px rgba(0,0,0,.3); }
    .main-content { margin-left: 0 !important; }
    .topbar { padding: 0 16px; }
    .topbar-clock { display: none; }
}
</style>
<asp:ContentPlaceHolder ID="head" runat="server" />
<script src="res/Bootstrap/bootstrap.bundle.min.js"></script>
</head>
<body>
<form id="form1" runat="server">
<asp:ScriptManager ID="MainScriptManager" runat="server" />

<!-- ════════ SIDEBAR ════════ -->
<aside id="sidebar" class="sidebar">
    <div class="brand">
        <div class="brand-icon"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
        <span class="brand-text">Shop<span class="brand-dot">POS</span></span>
    </div>
    <nav class="sidebar-nav">
        <div class="sidebar-section"><span class="menu-text">Main</span></div>
        <asp:HyperLink ID="lnkDashboard" NavigateUrl="~/Default.aspx" runat="server" CssClass="nav-link">
            <span class="nav-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span>
            <span class="menu-text">Dashboard</span>
        </asp:HyperLink>
        <asp:HyperLink ID="lnkPOS" NavigateUrl="~/POS.aspx" runat="server" CssClass="nav-link">
            <span class="nav-icon"><svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></span>
            <span class="menu-text">New Sale</span>
        </asp:HyperLink>
        <asp:HyperLink ID="lnkProducts" NavigateUrl="~/Products.aspx" runat="server" CssClass="nav-link">
            <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span>
            <span class="menu-text">Products</span>
        </asp:HyperLink>
        <asp:HyperLink ID="lnkReports" NavigateUrl="~/Reports.aspx" runat="server" CssClass="nav-link">
            <span class="nav-icon"><svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></span>
            <span class="menu-text">Sales History</span>
        </asp:HyperLink>
        <asp:HyperLink ID="lnkAnalytics" NavigateUrl="~/Analytics.aspx" runat="server" CssClass="nav-link">
            <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="7.5 4.21 12 6.81 16.5 4.21"/><polyline points="7.5 19.79 7.5 14.6 3 12"/><polyline points="21 12 16.5 14.6 16.5 19.79"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span>
            <span class="menu-text">Analytics</span>
        </asp:HyperLink>

        <hr class="sidebar-divider" />
        <div class="sidebar-section"><span class="menu-text">Administration</span></div>

        <asp:HyperLink ID="lnkAdminLogin" NavigateUrl="~/AdminLogin.aspx" runat="server" CssClass="nav-link">
            <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
            <span class="menu-text">Admin Login</span>
        </asp:HyperLink>
        <asp:HyperLink ID="lnkAdminUsers" NavigateUrl="~/AdminUsers.aspx" runat="server" Visible="false" CssClass="nav-link">
            <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
            <span class="menu-text">Add Admin</span>
        </asp:HyperLink>
        <asp:HyperLink ID="lnkChangePassword" NavigateUrl="~/ChangePassword.aspx" runat="server" Visible="false" CssClass="nav-link">
            <span class="nav-icon"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
            <span class="menu-text">Change Password</span>
        </asp:HyperLink>
        <asp:LinkButton ID="btnLogout" runat="server" Visible="false" OnClick="btnLogout_Click" CssClass="nav-link">
            <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span>
            <span class="menu-text">Logout</span>
        </asp:LinkButton>
    </nav>
</aside>

<!-- ════════ MAIN ════════ -->
<main class="main-content">
    <header class="topbar">

    <div class="topbar-left">

        <button type="button" 
                class="sidebar-toggle" 
                onclick="toggleSidebar()">

            <svg viewBox="0 0 24 24">
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>

        </button>


        <span class="topbar-title">
            <%: Page.Title %>
        </span>


    </div>



    <div class="center-shop-name">

        <span>
            Arif Shop
        </span>

    </div>




    <div class="topbar-right">

        <span class="topbar-clock" id="topClock"></span>

        <asp:Label ID="lblCurrentUser" 
                   runat="server" 
                   CssClass="user-chip" />

    </div>


</header>
    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
</main>

</form>
<script>
var sidebarStorageKey = 'shoppos-sidebar-collapsed';

// Restore the desktop sidebar state after navigation or postback.
(function restoreSidebarState() {
    var sidebar = document.getElementById('sidebar');
    if (!sidebar || window.innerWidth <= 768) return;

    try {
        if (localStorage.getItem(sidebarStorageKey) === 'true') {
            sidebar.classList.add('collapsed');
        }
    } catch (e) {
        // The sidebar still works if browser storage is unavailable.
    }
})();

function toggleSidebar() {
    var s = document.getElementById('sidebar');
    if (window.innerWidth <= 768) {
        s.classList.toggle('mobile-open');
        return;
    }

    s.classList.toggle('collapsed');
    try {
        localStorage.setItem(sidebarStorageKey, s.classList.contains('collapsed'));
    } catch (e) {
        // The current page can still toggle if browser storage is unavailable.
    }
}
// Live clock
(function updateClock() {
    var el = document.getElementById('topClock');
    if (el) {
        var now = new Date();
        var h = now.getHours(), m = now.getMinutes(), s = now.getSeconds();
        var ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        el.textContent = h + ':' + (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s + ' ' + ampm;
    }
    setTimeout(updateClock, 1000);
})();
// Active nav highlight
(function () {
    var page = location.pathname.split('/').pop().toLowerCase() || 'default.aspx';
    var links = document.querySelectorAll('.sidebar .nav-link');
    for (var i = 0; i < links.length; i++) {
        var href = (links[i].getAttribute('href') || '').toLowerCase();
        if (href && page === href.split('/').pop()) links[i].classList.add('active');
    }
})();
</script>
</body></html>
